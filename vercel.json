{
  "rewrites": [
    {
      "source": "/blog/:path*",
      "destination": "https://auth.wryko.com/functions/v1/public-seo/wrkmatic/blog/:path*"
    },
    {
      "source": "/llms.txt",
      "destination": "https://auth.wryko.com/functions/v1/public-seo/wrkmatic/llms.txt"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/demos",
      "destination": "/demos/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
