{
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "https://auth.wryko.com/functions/v1/public-seo/wrkmatic/llms.txt"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/demos",
      "destination": "/demos/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/seo-preview/:kind",
      "destination": "/seo-preview/:kind/index.html"
    },
    {
      "source": "/:slug([a-z0-9]+-[a-z0-9-]+)",
      "destination": "/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
